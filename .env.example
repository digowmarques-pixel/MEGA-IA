# ==== Sessão / login ====
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria

# ==== Higgsfield ====
# mock = simulação local (sem gastar créditos)
# mcp  = usa o MCP da conta Higgsfield (recomendado: mesmo catálogo de modelos + custo real via get_cost)
# api  = usa a API REST do Higgsfield Cloud (cloud.higgsfield.ai -> API keys)
HIGGSFIELD_MODE=mock
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_MCP_TOKEN=
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# ==== Claude (enhance de prompt + assistente) ====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ==== ElevenLabs (áudio) ====
ELEVENLABS_API_KEY=
